{
    "name": "spiral-sounds",
    "version": "1.0.0",
    "description": "Online classic vinyl store",
    "main": "server.js",
    "type": "module",
    "scripts": {
        "start": "node --env-file-if-exists=.env --import ./instrument.js server.js",
        "db:init": "node --env-file-if-exists=.env scripts/init-db.js",
        "test": "node --test",
        "test:coverage": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info",
        "test:postgres": "bash scripts/start-test-postgres.sh npm test",
        "db:init:abuse": "node --env-file-if-exists=.env scripts/init-abuse.js",
        "db:init:sessions": "node --env-file-if-exists=.env scripts/init-sessions.js"
    },
    "author": "Kevin Ngongang",
    "license": "ISC",
    "dependencies": {
        "@sentry/node": "11.8.0",
        "bcryptjs": "^3.0.2",
        "connect-pg-simple": "10.0.0",
        "express": "^4.22.3",
        "express-session": "^1.18.2",
        "pg": "^8.23.1",
        "proxy-addr": "2.0.8",
        "validator": "^13.15.35"
    },
    "devDependencies": {
        "playwright": "1.64.1",
        "yaml": "2.9.1"
    }
}
