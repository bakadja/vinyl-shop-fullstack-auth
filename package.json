    "license": "ISC",
    "dependencies": {
        "bcryptjs": "^3.0.2",
        "connect-pg-simple": "10.0.0",
        "express": "^4.22.3",
        "express-session": "^1.18.2",
        "pg": "^8.23.1",
        "proxy-addr": "2.0.8",
        "validator": "^13.15.35"
    },
    "devDependencies": {
        "playwright": "1.64.1"
    }
}
