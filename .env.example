# Replace placeholders locally; environment values override this optional file.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=vinyl_shop
PGUSER=vinyl_shop
PGPASSWORD=replace-with-a-local-password
PGSSLMODE=disable
SPIRAL_SESSION_SECRET=replace-with-a-local-session-secret
# Separate disposable Compose test instance. Never use app credentials for tests.
VINYL_TEST_ADMIN_PASSWORD=replace-with-a-disposable-admin-password
VINYL_TEST_PASSWORD=replace-with-a-disposable-test-password
# Set TEST_DATABASE_URL in your shell using the test credentials and port 15433.
